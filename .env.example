# Copy to .env.local and fill in YOUR values. Never commit .env.local.
# Required: a fresh PostgreSQL database, AUTH_SECRET, and bootstrap credentials.
# Use DATABASE_URL for standard PostgreSQL or transaction pooling at runtime.
DATABASE_URL=""
# Optional session/direct URL used by Prisma migrations (e.g. Supabase port 5432).
DATABASE_URL_UNPOOLED=""
# Compatibility: POSTGRES_PRISMA_URL / POSTGRES_URL / POSTGRES_URL_NON_POOLING.
# Empty values are ignored. Database passwords must be URL-encoded.

# Remote PostgreSQL verifies TLS certificates by default.
# Obtain the CA from YOUR provider. Leave empty for the system trust store.
PG_CA_CERT=""
# Optional local-only escape hatch; not recommended for production.
PG_TLS_REJECT_UNAUTHORIZED="true"

# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
APP_TIMEZONE="Asia/Shanghai"
# Local: http://localhost:3000. Production: your own HTTPS site root.
APP_URL="http://localhost:3000"

# Initial administrator; no default password and no prefilled household data.
SEED_USERNAME="admin"
SEED_DISPLAY_NAME="管理员"
SEED_PASSWORD=""

# Optional AI: key is server-only; leave empty to use forms/local parsing.
AI_ENABLED="true"
DEEPSEEK_API_KEY=""
AI_MODEL="deepseek-flash"
AI_TIMEOUT_MS="8000"

# Optional QQ official bot. Create your OWN application and configure its webhook.
QQ_BOT_APP_ID=""
QQ_BOT_APP_SECRET=""
QQ_BOT_SANDBOX="false"

# Optional private product library: use YOUR Supabase project and secret key.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
# Legacy SUPABASE_SERVICE_ROLE_KEY is also accepted; never expose either to clients.

# Optional Web Push: pnpm exec web-push generate-vapid-keys --json
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""
# Your own HTTPS origin or a mailto: contact; defaults to APP_URL if unset.
WEB_PUSH_SUBJECT=""

# Scheduler tokens: generate two different random values, each at least 32 chars.
# Cron routes reject requests when their token is unset.
CRON_SECRET=""
REMINDER_CRON_SECRET=""
# Vercel function region: choose a region near YOUR database.
VERCEL_FUNCTION_REGION="sin1"

# Optional browser checks: use a separate test database and explicit credentials.
VERIFY_USERNAME=""
VERIFY_PASSWORD=""
